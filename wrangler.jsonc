{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Renaming this creates a NEW Worker rather than renaming the existing one:
  // the Custom Domain, build vars and Deploy Hook stay behind on the old
  // script, so deploys keep succeeding while the live site freezes. Changing
  // it means re-attaching all of that in the dashboard and deleting the old
  // Worker.
  "name": "font-fridge",
  // Thin wrapper over @tanstack/react-start/server-entry that adds security
  // headers to SSR HTML responses (static assets get them via public/_headers).
  "main": "src/server-entry.ts",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // The site is served from font.chingru.com (attached as a Custom Domain in
  // the Cloudflare dashboard, which is why there's no `routes` here). Turn off
  // the font-fridge.<subdomain>.workers.dev URL so the same content isn't
  // reachable from a second origin: duplicate origins split SEO ranking signals
  // and would serve the absolute canonical/og:url/sitemap URLs (all baked to
  // font.chingru.com at build time) from a domain that contradicts them.
  // preview_urls defaults to false already, but it's stated for the same
  // reason: per-version <version>-font-fridge.<subdomain>.workers.dev origins.
  "workers_dev": false,
  "preview_urls": false,
  // Static assets binding so the detail page's SSR loader can read the prebuilt
  // per-font JSON via env.ASSETS.fetch() (a Worker fetching its own URL would
  // recurse instead of hitting assets). directory is the vite build's client
  // output.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
