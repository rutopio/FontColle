{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fontcolle",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "font-finder-d1",
      "database_id": "d2394735-b199-4bce-a639-7a90314f1bda",
      "migrations_dir": "src/lib/db/migrations",
      // Dev hits the local miniflare D1 (migrated + seeded from src/data via
      // `pnpm db:apply:local && pnpm db:seed:local`) so queries are on-disk and
      // fast, instead of round-tripping the remote production D1 on every load.
      "remote": false
    }
  ]
}
