# Copy to .env and fill in. .env is gitignored.

# Google Fonts Developer API key — used by scripts/harvester/fetch_published.py
# to fetch the published whitelist + popularity/trending signals.
GOOGLE_FONTS_API_KEY=

# GitHub token (optional) — raises the API rate limit when daily_update.py
# enumerates the google/fonts repo tree. A classic token with no scopes is fine.
GITHUB_TOKEN=

# Cloudflare credentials for the R2 data assets (src/data/fonts.json,
# public/glyphs, public/og — see src/data/data-manifest.json). `pnpm pull:data`
# needs R2 read on the fontcolle-assets bucket; `pnpm publish:assets` needs
# write. Unset is fine if you already have the files locally: the R2 helpers are
# only imported when an asset is missing. ACCOUNT_ID has no default, it must
# name the account that owns your bucket.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Production origin, no trailing slash (e.g. https://fontcolle.com). Enables the
# absolute-URL SEO fields: og:image, og:url, canonical, sitemap, JSON-LD. When
# unset they degrade gracefully rather than emit a wrong domain. Build-time only.
VITE_SITE_URL=https://fontcolle.com
