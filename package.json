{
  "name": "font-finder",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write . && pnpm check-types",
    "check-types": "tsc --noEmit",
    "ui": "pnpm dlx shadcn@latest",
    "db": "drizzle-kit",
    "db:apply:local": "wrangler d1 migrations apply font-finder-d1 --local",
    "db:apply:remote": "wrangler d1 migrations apply font-finder-d1 --remote",
    "db:seed:gen": "python3 scripts/harvester/to_seed_sql.py src/data/fonts.json src/lib/db/seed",
    "db:seed:local": "bash scripts/seed-d1.sh --local",
    "db:seed:remote": "bash scripts/seed-d1.sh --remote"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@cloudflare/vite-plugin": "1.40.0",
    "@cloudflare/workers-types": "4.20260609.1",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "drizzle-kit": "0.31.10",
    "jsdom": "^28",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4",
    "wrangler": "4.98.0"
  }
}
