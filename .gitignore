scripts/harvester/published.json
scripts/harvester/stress_output.json
scripts/harvester/og_ids.txt

# Generated at build time from the catalog (scripts/gen-sitemap.mjs)
/public/sitemap.xml
/public/llms.txt
# Generated at build time from the catalog (scripts/gen-catalog.mjs): the static
# data the site serves in place of a database.
/public/catalog.json
/public/catalog-first.json
/public/catalog/
/public/catalog-v/
/public/catalog-manifest.json
/public/designer-index.json
/.agents
/.claude
skills-lock.json

# Data assets moved out of git into R2 (see scripts/sync-assets.mjs +
# src/data/data-manifest.json). Pulled locally via `pnpm pull:data`; the daily
# CI rewrites fonts.json and og. The git-versioned manifest is the source of
# truth for which R2 versions the site ships.
/src/data/fonts.json
/public/glyphs/
/public/og/
# Scratch dir for R2 up/downloads (tarballs, fonts version).
/.r2-tmp/
