node_modules
.DS_Store
dist
*.local
.env*
!.env.example
.tanstack
.wrangler
tasks/

# typescript
*.tsbuildinfo
scripts/harvester/*.log

scripts/harvester/__pycache__/
# dev-only TTF download cache (harvest.py fetch; delete or TTF_CACHE=0 for release runs)
scripts/harvester/ttf_cache/
# harvester intermediates (regenerated by harvest.py / fetch_published.py), not
# shipped data — the built catalog lives in src/data/fonts.json
scripts/harvester/published.json
scripts/harvester/stress_output.json
scripts/harvester/og_ids.txt

# Generated at build time from the catalog (scripts/gen-sitemap.mjs)
/public/sitemap.xml
/public/llms.txt
# Generated at build time from the catalog (scripts/gen-catalog.mjs): the static
# data the site serves in place of a database.
/public/catalog.json
/public/catalog-first.json
/public/catalog-slim.json
/public/catalog/
/public/catalog-v/
/public/catalog-manifest.json
/public/designer-index.json
# Generated at build time from public/glyphs (scripts/gen-glyph-index.mjs)
/public/glyph-index.json
/.agents
/.claude
skills-lock.json

# Data assets moved out of git into R2 (see scripts/sync-assets.mjs). Pulled
# locally via `pnpm pull:data`; the daily CI rewrites them in R2. The manifest
# (manifest/latest.json in R2) is the source of truth for which R2 versions the
# site ships — it left git too so a data-only harvest makes no commit; the local
# copy below is just a pull:data scratch artifact.
/src/data/fonts.json
/src/data/data-manifest.json
/public/glyphs/
/public/og/
# Scratch dir for R2 up/downloads (tarballs, fonts version) + manifest temp.
/.r2-tmp/
/.r2-manifest.json
