# Cloudflare's build pipeline invokes `npm` around the user build command, and
# npm inherits the npm_config_* env vars pnpm projects for its own settings
# (minimum-release-age, verify-deps-before-run, @jsr:registry). npm doesn't
# recognise those keys and logs an "Unknown env config" warning for each, on
# every npm call, flooding the build log. Dropping npm's log level to error
# silences them. Note: this also applies to pnpm (which reads .npmrc too), so
# pnpm's own warn-level output is quieted in the same way — acceptable here,
# install warnings are seen locally before CI.
loglevel=error
